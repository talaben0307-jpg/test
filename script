local function applyPreset(p, quiet)
    local asset = presetAsset(p)
    if asset == "" then
        if not quiet then
            Library:Notify({ Title = "Ảnh nền", Content = "Ảnh chưa tải xong hoặc executor không hỗ trợ lưu file.", Duration = 3 })
        end
        return
    end
    Window.BgImage.Image = asset
    if fsOk then
        pcall(writefile, BG_DIR .. "/selected.txt", p.Name)
    end
end

