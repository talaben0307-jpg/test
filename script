end)

local CAM_BIND = "UniverseCamlock"
RunService:BindToRenderStep(CAM_BIND, Enum.RenderPriority.Camera.Value + 1, function(dt)
    if not camlock.Enabled then return end

    local char = camlock.Target
    if not charAlive(char) then
        camUnlock(true)
        Library:Notify({ Title = "Camlock", Content = "Mục tiêu đã chết hoặc thoát game.", Duration = 2 })
