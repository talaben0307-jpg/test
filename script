    local subTitle = cfg.SubTitle or ""
    local key = cfg.Key
    local menuKey = cfg.MenuKey or Enum.KeyCode.F

    local unlocked = (key == nil)
    local visible = false
    local visToken = 0
    local KeyGui = nil

    local MainGui = create("ScreenGui", {
        Name = "UniverseHub", ResetOnSpawn = false, Enabled = false, Parent = parentGui,
    })
    local FloatGui = create("ScreenGui", {
        Name = "UniverseFloat", ResetOnSpawn = false, Enabled = false, Parent = parentGui,
    })
    onCleanup(function()
        MainGui:Destroy()
        FloatGui:Destroy()
        if KeyGui then KeyGui:Destroy() end
    end)

    -- Khung chính
    local Main = create("CanvasGroup", {
        Name = "Main",
        Parent = MainGui,
        AnchorPoint = Vector2.new(0.5, 0.5),
        Position = UDim2.new(0.5, 0, 0.5, 0),
        Size = UDim2.new(0, 580, 0, 400),
        BackgroundColor3 = Theme.Background,
        BackgroundTransparency = 0.9,
        GroupTransparency = 1,
    }, { corner(12) })
    addAccentStroke(Main, 2)

    local BgImage = create("ImageLabel", {
        Parent = Main,
        BackgroundTransparency = 1,
        Size = UDim2.new(1, 0, 1, 0),
        ScaleType = Enum.ScaleType.Crop,
        ImageTransparency = 0.75,
        ZIndex = 0,
        Image = "",
    }, { corner(12) })

    local Scale = create("UIScale", { Parent = Main })
    local function updateScale()
        local cam = Workspace.CurrentCamera
        if cam then
            local vs = cam.ViewportSize
            Scale.Scale = math.clamp(math.min(vs.X / 640, vs.Y / 460), 0.55, 1)
        end
    end
    updateScale()
    if Workspace.CurrentCamera then
        track(Workspace.CurrentCamera:GetPropertyChangedSignal("ViewportSize"):Connect(updateScale))
    end

    -- Thanh tiêu đề
    local TopBar = create("Frame", {
        Parent = Main,
        BackgroundColor3 = Theme.Panel,
        BackgroundTransparency = 0.72,
        Size = UDim2.new(1, 0, 0, 46),
    })
    create("Frame", {
        Parent = Main,
        BackgroundColor3 = Theme.Stroke,
        Position = UDim2.new(0, 0, 0, 46),
        Size = UDim2.new(1, 0, 0, 1),
    })
    create("TextLabel", {
        Parent = TopBar,
        BackgroundTransparency = 1,
        Position = UDim2.new(0, 16, 0, 0),
        Size = UDim2.new(1, -120, 1, 0),
        Font = Enum.Font.Gotham,
        RichText = true,
        Text = ('⚡ <b>%s</b>   <font color="rgb(150,150,172)">%s</font>'):format(title, subTitle),
        TextSize = 14,
        TextColor3 = Theme.Accent,
        TextXAlignment = Enum.TextXAlignment.Left,
    })

    local function topButton(text, xOff, hoverColor)
        local b = create("TextButton", {
            Parent = TopBar,
            AnchorPoint = Vector2.new(1, 0.5),
            Position = UDim2.new(1, xOff, 0.5, 0),
            Size = UDim2.new(0, 28, 0, 28),
            BackgroundColor3 = Theme.Element,
            Font = Enum.Font.GothamBold,
            Text = text,
            TextSize = 14,
            TextColor3 = Theme.Text,
            AutoButtonColor = false,
        }, { corner(6) })
        b.MouseEnter:Connect(function() tween(b, 0.15, { BackgroundColor3 = hoverColor }) end)
        b.MouseLeave:Connect(function() tween(b, 0.15, { BackgroundColor3 = Theme.Element }) end)
        return b
    end
    local CloseBtn = topButton("X", -12, Theme.Danger)
    local MinBtn = topButton("–", -46, Theme.ElementHover)

    makeDraggable(TopBar, Main, Scale)

    -- Sidebar + nội dung
    local Sidebar = create("ScrollingFrame", {
        Parent = Main,
        BackgroundTransparency = 1,
        Position = UDim2.new(0, 12, 0, 58),
        Size = UDim2.new(0, 140, 1, -70),
        CanvasSize = UDim2.new(0, 0, 0, 0),
        AutomaticCanvasSize = Enum.AutomaticSize.Y,
        ScrollBarThickness = 0,
    }, {
        create("UIListLayout", { SortOrder = Enum.SortOrder.LayoutOrder, Padding = UDim.new(0, 6) }),
    })
    local Content = create("Frame", {
        Parent = Main,
        BackgroundTransparency = 1,
        Position = UDim2.new(0, 164, 0, 58),
        Size = UDim2.new(1, -176, 1, -70),
        ClipsDescendants = true,
    })

    -- Nút nổi HUB
    local FloatBtn = create("TextButton", {
        Parent = FloatGui,
        BackgroundColor3 = Theme.Background,
        BackgroundTransparency = 0.1,
        Position = UDim2.new(0, 50, 0, 200),
        Size = UDim2.new(0, 56, 0, 56),
        Font = Enum.Font.GothamBold,
        Text = "HUB",
        TextSize = 13,
        TextColor3 = Theme.Accent,
        AutoButtonColor = false,
    }, { create("UICorner", { CornerRadius = UDim.new(1, 0) }) })
    addAccentStroke(FloatBtn, 2)
    local floatWasDragged = makeDraggable(FloatBtn, FloatBtn)

    -- Ẩn / hiện
    local function setVisible(state)
        if not unlocked then return end
        visible = state
        visToken += 1
        local my = visToken
        if state then
            FloatGui.Enabled = false
            MainGui.Enabled = true
            tween(Main, 0.3, { GroupTransparency = 0 })
        else
            tween(Main, 0.2, { GroupTransparency = 1 })
            task.delay(0.2, function()
                if my == visToken then
                    MainGui.Enabled = false
                    FloatGui.Enabled = true
                end
            end)
        end
    end

    MinBtn.MouseButton1Click:Connect(function() setVisible(false) end)
    FloatBtn.MouseButton1Click:Connect(function()
        if floatWasDragged() then return end
        setVisible(true)
    end)
    CloseBtn.MouseButton1Click:Connect(function()
        if env.UniverseCleanup then env.UniverseCleanup() end
    end)

    track(UserInputService.InputBegan:Connect(function(input, gp)
        if not gp and unlocked and input.KeyCode == menuKey then
            setVisible(not visible)
        end
    end))

    local function openFirst()
        unlocked = true
        if cfg.OnUnlock then pcall(cfg.OnUnlock) end
        Main.Position = UDim2.new(0.5, 0, 0.5, 30)
        setVisible(true)
        tween(Main, 0.45, { Position = UDim2.new(0.5, 0, 0.5, 0) }, Enum.EasingStyle.Back)
        Library:Notify({
            Title = title,
            Content = "Mở khoá thành công! Nhấn " .. menuKey.Name .. " để ẩn/hiện menu.",
            Duration = 4,
        })
    end

    -- ===== Hệ thống key =====
    if key ~= nil then
        KeyGui = create("ScreenGui", { Name = "UniverseKey", ResetOnSpawn = false, Parent = parentGui })
        local KeyFrame = create("CanvasGroup", {
            Parent = KeyGui,
            AnchorPoint = Vector2.new(0.5, 0.5),
            Position = UDim2.new(0.5, 0, 0.5, 0),
            Size = UDim2.new(0, 380, 0, 210),
            BackgroundColor3 = Theme.Background,
            GroupTransparency = 1,
        }, { corner(12) })
        addAccentStroke(KeyFrame, 2)

        create("TextLabel", {
            Parent = KeyFrame, BackgroundTransparency = 1,
            Position = UDim2.new(0, 24, 0, 18), Size = UDim2.new(1, -80, 0, 24),
            Font = Enum.Font.GothamBold, Text = "🔐 Xác thực key", TextSize = 17,
            TextColor3 = Theme.Accent, TextXAlignment = Enum.TextXAlignment.Left,
        })
        create("TextLabel", {
            Parent = KeyFrame, BackgroundTransparency = 1,
            Position = UDim2.new(0, 24, 0, 44), Size = UDim2.new(1, -48, 0, 18),
            Font = Enum.Font.Gotham, Text = "Nhập key để mở khoá " .. title, TextSize = 12,
            TextColor3 = Theme.SubText, TextXAlignment = Enum.TextXAlignment.Left,
        })

        local KeyBox = create("TextBox", {
            Parent = KeyFrame,
            BackgroundColor3 = Theme.Element,
            Position = UDim2.new(0, 24, 0, 78),
            Size = UDim2.new(1, -48, 0, 42),
            Font = Enum.Font.Gotham,
            PlaceholderText = "Nhập key tại đây...",
            PlaceholderColor3 = Theme.SubText,
            Text = "",
            TextColor3 = Theme.Text,
            TextSize = 14,
            ClearTextOnFocus = false,
        }, { corner(8), create("UIPadding", { PaddingLeft = UDim.new(0, 12), PaddingRight = UDim.new(0, 12) }) })
        local boxStroke = stroke(Theme.Stroke, 1)
        boxStroke.Parent = KeyBox
        KeyBox.Focused:Connect(function() tween(boxStroke, 0.15, { Color = Theme.Accent }) end)
        KeyBox.FocusLost:Connect(function() tween(boxStroke, 0.15, { Color = Theme.Stroke }) end)

        local Submit = create("TextButton", {
            Parent = KeyFrame,
            BackgroundColor3 = Theme.Accent,
            Position = UDim2.new(0, 24, 0, 138),
            Size = UDim2.new(1, -48, 0, 42),
            Font = Enum.Font.GothamBold,
            Text = "MỞ KHOÁ",
            TextSize = 14,
            TextColor3 = Theme.Background,
            AutoButtonColor = false,
        }, { corner(8) })

        local KeyClose = create("TextButton", {
            Parent = KeyFrame,
            AnchorPoint = Vector2.new(1, 0),
            Position = UDim2.new(1, -14, 0, 14),
            Size = UDim2.new(0, 26, 0, 26),
            BackgroundColor3 = Theme.Element,
            Font = Enum.Font.GothamBold,
            Text = "X",
            TextSize = 12,
            TextColor3 = Theme.Text,
            AutoButtonColor = false,
        }, { corner(6) })
        KeyClose.MouseButton1Click:Connect(function()
            if env.UniverseCleanup then env.UniverseCleanup() end
        end)

        tween(KeyFrame, 0.4, { GroupTransparency = 0 })

        local keyToken = 0
        local function trySubmit()
            local input = (KeyBox.Text:gsub("%s", ""))
            if input == key then
                tween(KeyFrame, 0.3, { GroupTransparency = 1 })
                task.delay(0.35, function()
                    if KeyGui then
                        KeyGui:Destroy()
                        KeyGui = nil
                    end
                    openFirst()
                end)
            else
                keyToken += 1
                local my = keyToken
                Submit.Text = "❌ SAI KEY, THỬ LẠI"
                tween(Submit, 0.15, { BackgroundColor3 = Theme.Danger })
                Submit.TextColor3 = Theme.Text
                task.delay(1.5, function()
                    if my == keyToken and Submit.Parent then
                        Submit.Text = "MỞ KHOÁ"
                        Submit.TextColor3 = Theme.Background
                        tween(Submit, 0.15, { BackgroundColor3 = Theme.Accent })
                    end
                end)
            end
        end
        Submit.MouseButton1Click:Connect(trySubmit)
        KeyBox.FocusLost:Connect(function(enter)
            if enter then trySubmit() end
        end)
    end

    -- ===== API Window =====
    local Window = { BgImage = BgImage }
    local tabs = {}

    local function selectTab(tab)
        for _, t in ipairs(tabs) do
            local active = (t == tab)
            t.Active = active
            t.Page.Visible = active
            tween(t.Button, 0.15, {
                BackgroundTransparency = active and 0.25 or 1,
                TextColor3 = active and Theme.Accent or Theme.SubText,
            })
            tween(t.Indicator, 0.15, { Size = UDim2.new(0, 3, 0, active and 18 or 0) })
        end
    end

    function Window:SelectTab(index)
        if tabs[index] then selectTab(tabs[index]) end
    end

    function Window:SetMenuKey(k)
        menuKey = k
    end

    -- a: 0 = đặc, 1 = trong suốt hoàn toàn (khung chính). Thanh tiêu đề và ô chức năng giữ mờ vừa đủ để đọc chữ.
    function Window:SetTransparency(a)
        a = math.clamp(a, 0, 1)
        Main.BackgroundTransparency = a
        TopBar.BackgroundTransparency = a * 0.8
        uiElementAlpha = 0.15 + a * 0.6
        for i = #uiElements, 1, -1 do
            local f = uiElements[i]
            if f.Parent then
                f.BackgroundTransparency = uiElementAlpha
            else
                table.remove(uiElements, i)
            end
        end
    end

    function Window:Destroy()
        if env.UniverseCleanup then env.UniverseCleanup() end
    end

    function Window:AddTab(tabCfg)
        tabCfg = tabCfg or {}
        local name = tabCfg.Title or "Tab"

        local Button = create("TextButton", {
            Parent = Sidebar,
            Size = UDim2.new(1, 0, 0, 36),
            BackgroundColor3 = Theme.Element,
            BackgroundTransparency = 1,
            AutoButtonColor = false,
            Font = Enum.Font.GothamSemibold,
            Text = (tabCfg.Icon and (tabCfg.Icon .. " ") or "") .. name,
            TextSize = 13,
            TextColor3 = Theme.SubText,
            TextXAlignment = Enum.TextXAlignment.Left,
        }, { corner(6), create("UIPadding", { PaddingLeft = UDim.new(0, 14) }) })

        local Indicator = create("Frame", {
            Parent = Button,
            AnchorPoint = Vector2.new(0, 0.5),
            Position = UDim2.new(0, -10, 0.5, 0),
            Size = UDim2.new(0, 3, 0, 0),
            BackgroundColor3 = Theme.Accent,
        }, { corner(2) })

        local Page = create("ScrollingFrame", {
            Parent = Content,
            BackgroundTransparency = 1,
            Size = UDim2.new(1, 0, 1, 0),
            Visible = false,
            CanvasSize = UDim2.new(0, 0, 0, 0),
            AutomaticCanvasSize = Enum.AutomaticSize.Y,
            ScrollBarThickness = 3,
            ScrollBarImageColor3 = Theme.Accent,
            ScrollingDirection = Enum.ScrollingDirection.Y,
        }, {
            create("UIListLayout", { SortOrder = Enum.SortOrder.LayoutOrder, Padding = UDim.new(0, 8) }),
            create("UIPadding", { PaddingRight = UDim.new(0, 10), PaddingBottom = UDim.new(0, 8) }),
        })

        local tab = { Button = Button, Indicator = Indicator, Page = Page, Active = false }
        table.insert(tabs, tab)

        Button.MouseButton1Click:Connect(function() selectTab(tab) end)
        Button.MouseEnter:Connect(function()
            if not tab.Active then tween(Button, 0.15, { BackgroundTransparency = 0.6 }) end
        end)
        Button.MouseLeave:Connect(function()
            if not tab.Active then tween(Button, 0.15, { BackgroundTransparency = 1 }) end
        end)
        if #tabs == 1 then selectTab(tab) end

        -- Helpers cho element
        local function element(height)
            local f = create("Frame", {
                Parent = Page,
                Size = UDim2.new(1, 0, 0, height or 40),
                BackgroundColor3 = Theme.Element,
                BackgroundTransparency = uiElementAlpha,
            }, { corner(8), stroke(Theme.Stroke, 1) })
            table.insert(uiElements, f)
            return f
        end
        local function titleLabel(parent, text, rightPad)
            return create("TextLabel", {
                Parent = parent,
                BackgroundTransparency = 1,
                Position = UDim2.new(0, 14, 0, 0),
                Size = UDim2.new(1, -28 - (rightPad or 0), 0, 40),
                Font = Enum.Font.Gotham,
                Text = text,
                TextSize = 13,
                TextColor3 = Theme.Text,
                TextXAlignment = Enum.TextXAlignment.Left,
            })
        end

        local Tab = {}

        function Tab:AddSection(text)
            create("TextLabel", {
                Parent = Page,
                BackgroundTransparency = 1,
                Size = UDim2.new(1, 0, 0, 22),
                Font = Enum.Font.GothamBold,
                Text = string.upper(text),
                TextSize = 11,
                TextColor3 = Theme.Accent,
                TextXAlignment = Enum.TextXAlignment.Left,
            })
        end

        function Tab:AddLabel(text)
            local f = element(36)
            local l = titleLabel(f, text)
            l.Size = UDim2.new(1, -28, 1, 0)
            l.TextColor3 = Theme.SubText
            l.TextWrapped = true
            local obj = {}
            function obj:SetText(t) l.Text = t end
            return obj
        end

        function Tab:AddButton(c)
            c = c or {}
            local f = element(40)
            titleLabel(f, c.Title or "Button", 24)
            create("TextLabel", {
                Parent = f,
                BackgroundTransparency = 1,
                AnchorPoint = Vector2.new(1, 0.5),
                Position = UDim2.new(1, -14, 0.5, 0),
                Size = UDim2.new(0, 20, 0, 20),
                Font = Enum.Font.GothamBold,
