-- Điểm ngắm: giữa màn hình khi Shiftlock, ngược lại là vị trí chuột
local function aimPoint()
    local camera = Workspace.CurrentCamera
    if UserInputService.MouseBehavior == Enum.MouseBehavior.LockCenter and camera then
        return camera.ViewportSize / 2
    end
    return UserInputService:GetMouseLocation()
end

local function findCamTarget()
    local camera = Workspace.CurrentCamera
    if not camera then return nil end
    local aim = aimPoint()
    local best, bestDist = nil, math.huge
    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= LocalPlayer and charAlive(p.Character) then
            local sp, onScreen = camera:WorldToViewportPoint(p.Character.HumanoidRootPart.Position)
            if onScreen then
                local d = (Vector2.new(sp.X, sp.Y) - aim).Magnitude
                if d < bestDist then
                    bestDist = d
                    best = p.Character
                end
            end
        end
    end
    return best
end

local function camUnlock(syncToggle)
    camlock.Enabled = false
    camlock.Target = nil
    clearCamHighlight()
    FurinaIcon.Visible = false
    renderCamBtn()
    if syncToggle and camToggle then camToggle:Set(false, true) end
end

local camMsgToken = 0
local function camLock()
    local target = findCamTarget()
    if not target then
        camlock.Enabled = false
        if camToggle then camToggle:Set(false, true) end
        renderCamBtn("❌ Không thấy mục tiêu!")
        camMsgToken += 1
        local my = camMsgToken
        task.delay(1.5, function()
            if my == camMsgToken and not camlock.Enabled then renderCamBtn() end
        end)
        return
    end
    camMsgToken += 1
    camlock.Enabled = true
    camlock.Target = target
    FurinaIcon.Visible = camlock.ShowIcon
    updateCamHighlight()
    renderCamBtn()
end

local function toggleCamlock()
    if camToggle then
        camToggle:Set(not camToggle.Value) -- gọi callback bên dưới
    elseif camlock.Enabled then
        camUnlock(false)
    else
        camLock()
    end
end

