-- HỆ THỐNG NHẬP KEY PHỦ TO MÀN HÌNH (KÉO THẢ ĐƯỢC)
-- ==========================================
local CorrectKey = "0946"

local function CreateKeyUI()
    local CoreGui = game:GetService("CoreGui")
    if CoreGui:FindFirstChild("UniverseKeySystem") then
        CoreGui.UniverseKeySystem:Destroy()
    end

    local ScreenGui = Instance.new("ScreenGui")
    ScreenGui.Name = "UniverseKeySystem"
    ScreenGui.Parent = CoreGui
    ScreenGui.ResetOnSpawn = false

    local MainFrame = Instance.new("Frame")
    MainFrame.Parent = ScreenGui
    MainFrame.BackgroundColor3 = Color3.fromRGB(25, 25, 35)
    MainFrame.Position = UDim2.new(0.5, -260, 0.5, -140)
    MainFrame.Size = UDim2.new(0, 520, 0, 280)

    local UICorner = Instance.new("UICorner")
    UICorner.CornerRadius = UDim.new(0, 12)
    UICorner.Parent = MainFrame

    local Title = Instance.new("TextLabel")
    Title.Parent = MainFrame
    Title.BackgroundColor3 = Color3.fromRGB(35, 35, 45)
    Title.Size = UDim2.new(1, 0, 0, 60)
    Title.Font = Enum.Font.GothamBold
    Title.Text = "🔐 XÁC THỰC KEY UNIVERSE SCRIPT"
    Title.TextColor3 = Color3.fromRGB(255, 255, 255)
    Title.TextSize = 18

    local TitleCorner = Instance.new("UICorner")
    TitleCorner.CornerRadius = UDim.new(0, 12)
    TitleCorner.Parent = Title

    -- Tính năng kéo thả (Draggable) mượt mà cho bảng Key
    local dragging, dragInput, dragStart, startPos
    Title.InputBegan:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseButton1 or input.UserInputType == Enum.UserInputType.Touch then
            dragging = true
            dragStart = input.Position
            startPos = MainFrame.Position
            
            input.Changed:Connect(function()
                if input.UserInputState == Enum.UserInputState.End then
                    dragging = false
                end
            end)
        end
    end)

    Title.InputChanged:Connect(function(input)
        if input.UserInputType == Enum.UserInputType.MouseMovement or input.UserInputType == Enum.UserInputType.Touch then
            dragInput = input
        end
    end)

    game:GetService("UserInputService").InputChanged:Connect(function(input)
        if input == dragInput and dragging then
            local delta = input.Position - dragStart
            MainFrame.Position = UDim2.new(startPos.X.Scale, startPos.X.Offset + delta.X, startPos.Y.Scale, startPos.Y.Offset + delta.Y)
        end
    end)

    local TextBox = Instance.new("TextBox")
    TextBox.Parent = MainFrame
    TextBox.BackgroundColor3 = Color3.fromRGB(45, 45, 55)
    TextBox.Position = UDim2.new(0, 35, 0, 95)
    TextBox.Size = UDim2.new(0, 450, 0, 60)
    TextBox.Font = Enum.Font.Gotham
    TextBox.PlaceholderText = "Nhập key tại đây (0946)..."
    TextBox.Text = ""
    TextBox.TextColor3 = Color3.fromRGB(255, 255, 255)
    TextBox.TextSize = 16

    local BoxCorner = Instance.new("UICorner")
    BoxCorner.CornerRadius = UDim.new(0, 8)
    BoxCorner.Parent = TextBox

    local SubmitBtn = Instance.new("TextButton")
    SubmitBtn.Parent = MainFrame
    SubmitBtn.BackgroundColor3 = Color3.fromRGB(50, 180, 50)
    SubmitBtn.Position = UDim2.new(0, 35, 0, 185)
    SubmitBtn.Size = UDim2.new(0, 450, 0, 60)
    SubmitBtn.Font = Enum.Font.GothamBold
    SubmitBtn.Text = "XÁC NHẬN MỞ KHÓA"
    SubmitBtn.TextColor3 = Color3.fromRGB(255, 255, 255)
    SubmitBtn.TextSize = 16

    local BtnCorner = Instance.new("UICorner")
    BtnCorner.CornerRadius = UDim.new(0, 8)
    BtnCorner.Parent = SubmitBtn

    SubmitBtn.MouseButton1Click:Connect(function()
        if TextBox.Text == CorrectKey then
            ScreenGui:Destroy()
            -- Hiện lại giao diện Fluent sau khi nhập đúng key
            if Window.Enabled ~= nil then
                Window.Enabled = true
            elseif Window.Show then
                Window:Show()
            end
            Fluent:Notify({Title = "THÀNH CÔNG", Content = "Đã mở khóa Script thành công!", Duration = 3})
        else
            SubmitBtn.Text = "❌ SAI KEY! THỬ LẠI"
            SubmitBtn.BackgroundColor3 = Color3.fromRGB(180, 50, 50)
            task.wait(1.5)
            SubmitBtn.Text = "XÁC NHẬN MỞ KHÓA"
            SubmitBtn.BackgroundColor3 = Color3.fromRGB(50, 180, 50)
        end
    end)
end

-- Kích hoạt bảng nhập Key
CreateKeyUI()

-- ==========================================
-- HÀM TẢI SCRIPT AN TOÀN (SAFE LOAD)
-- ==========================================
local function SafeLoad(url, name)
    local success, err = pcall(function()
        loadstring(game:HttpGet(url))()
    end)
    if success then
        Fluent:Notify({Title = "THÀNH CÔNG", Content = "Đã chạy script: " .. name, Duration = 3})
    else
        Fluent:Notify({Title = "THẤT BẠI", Content = "Lỗi khi tải " .. name .. "! Vui lòng thử lại sau.", Duration = 5})
        warn("Lỗi Script [" .. name .. "]: " .. tostring(err))
    end
end

