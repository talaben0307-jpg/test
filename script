    end

    local camera = Workspace.CurrentCamera
    if not camera then return end
    local hrp = char.HumanoidRootPart
    local predicted = hrp.Position + camlock.Offset + hrp.AssemblyLinearVelocity * camlock.Prediction
    local desired = CFrame.lookAt(camera.CFrame.Position, predicted)
    camera.CFrame = camera.CFrame:Lerp(desired, 1 - math.exp(-camlock.Speed * dt))
end)
