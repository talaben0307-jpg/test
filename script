    pcall(function() RunService:UnbindFromRenderStep(CAM_BIND) end)
    pcall(clearCamHighlight)
end)

-- ===== JJS: Auto BF / Dash Chain =====
local jjs = { BfDelay = 0.35, DashTime = 0.15, Curve = 8, Range = 40, PostDash = 0.2 }

local function pressKey(code, hold)
    pcall(function() VirtualInputManager:SendKeyEvent(true, code, false, game) end)
    task.wait(hold or 0.05)
    pcall(function() VirtualInputManager:SendKeyEvent(false, code, false, game) end)
end

local function nearestEnemyHrp(range)
    local char = LocalPlayer.Character
    local myHrp = char and char:FindFirstChild("HumanoidRootPart")
    if not myHrp then return nil, nil end
    local best, bestDist = nil, range
    for _, p in ipairs(Players:GetPlayers()) do
        if p ~= LocalPlayer and p.Character then
            local hrp = p.Character:FindFirstChild("HumanoidRootPart")
            local hum = p.Character:FindFirstChildOfClass("Humanoid")
            if hrp and hum and hum.Health > 0 then
                local d = (hrp.Position - myHrp.Position).Magnitude
                if d < bestDist then
                    best, bestDist = hrp, d
                end
            end
        end
    end
    return best, myHrp
end

-- Lướt theo đường cong Bezier tới sau lưng đối thủ
local function dashTo(myHrp, targetHrp, duration)
    local startPos = myHrp.Position
    local endPos = (targetHrp.CFrame * CFrame.new(0, 0, 4)).Position
    local delta = endPos - startPos
    if delta.Magnitude < 1 then return end

    local flat = Vector3.new(delta.X, 0, delta.Z)
    local dir = (flat.Magnitude > 0.01) and flat.Unit or Vector3.new(0, 0, -1)
    local right = Vector3.new(dir.Z, 0, -dir.X)
    local side = (math.random(1, 2) == 1) and 1 or -1
    local midPos = (startPos + endPos) / 2 + right * side * jjs.Curve

    local elapsed = 0
    while elapsed < duration do
        local dt = RunService.Heartbeat:Wait()
        elapsed += dt
        if not (myHrp.Parent and targetHrp.Parent) then break end

        local t = math.clamp(elapsed / duration, 0, 1)
        local e = 1 - (1 - t) * (1 - t)
        local p = startPos:Lerp(midPos, e):Lerp(midPos:Lerp(endPos, e), e)
        local look = Vector3.new(targetHrp.Position.X, p.Y, targetHrp.Position.Z)
        if (look - p).Magnitude > 0.01 then
            myHrp.CFrame = CFrame.lookAt(p, look)
        else
            myHrp.CFrame = CFrame.new(p)
        end
        myHrp.AssemblyLinearVelocity = Vector3.zero
    end
end

local function executeDashAndTiming()
    local targetHrp, myHrp = nearestEnemyHrp(jjs.Range)
    if targetHrp and myHrp then
        dashTo(myHrp, targetHrp, jjs.DashTime)
        task.wait(jjs.PostDash)
    else
        task.wait(jjs.BfDelay)
    end
    pressKey(Enum.KeyCode.Three)
end

local bfToggle, dashToggle = nil, nil
local chainMode = nil -- "bf" | "dash" | nil
local chainBusy = false

track(UserInputService.InputBegan:Connect(function(input, gp)
    if gp or chainBusy or not chainMode then return end
    if input.KeyCode ~= Enum.KeyCode.Three then return end

    chainBusy = true
    task.spawn(function()
        if chainMode == "dash" then
            executeDashAndTiming()
        else
            task.wait(jjs.BfDelay)
            pressKey(Enum.KeyCode.Three)
        end
        task.wait(0.5)
        chainBusy = false
    end)
end))

