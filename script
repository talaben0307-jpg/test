local function SafeLoad(url, name)
    local success, err = pcall(function()
        loadstring(game:HttpGet(url))()
    end)
    if success then
        print("THÀNH CÔNG: Đã chạy script: " .. tostring(name))
        Library:Notify({ Title = "Thành công", Content = "Đã chạy script: " .. tostring(name), Duration = 3 })
    else
        warn("Lỗi Script [" .. tostring(name) .. "]: " .. tostring(err))
        Library:Notify({ Title = "Lỗi Script", Content = "Không thể chạy: " .. tostring(name), Duration = 3 })
