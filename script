                Size = UDim2.new(0, 20, 0, 20),
                Font = Enum.Font.GothamBold,
                Text = "›",
                TextSize = 20,
                TextColor3 = Theme.Accent,
            })
            local hit = create("TextButton", {
                Parent = f, Size = UDim2.new(1, 0, 1, 0),
                BackgroundTransparency = 1, Text = "", AutoButtonColor = false,
            })
            hit.MouseEnter:Connect(function() tween(f, 0.15, { BackgroundColor3 = Theme.ElementHover }) end)
            hit.MouseLeave:Connect(function() tween(f, 0.15, { BackgroundColor3 = Theme.Element }) end)
            hit.MouseButton1Click:Connect(function()
                tween(f, 0.08, { BackgroundColor3 = Theme.AccentDim })
                task.delay(0.12, function()
                    if f.Parent then tween(f, 0.15, { BackgroundColor3 = Theme.ElementHover }) end
                end)
                if c.Callback then task.spawn(pcall, c.Callback) end
            end)
        end

        function Tab:AddKeybind(c)
            c = c or {}
            local f = element(40)
            titleLabel(f, c.Title or "Keybind", 80)
            local btn = create("TextButton", {
                Parent = f,
                AnchorPoint = Vector2.new(1, 0.5),
                Position = UDim2.new(1, -14, 0.5, 0),
                Size = UDim2.new(0, 70, 0, 24),
                BackgroundColor3 = Theme.Off,
                Font = Enum.Font.GothamBold,
                TextSize = 11,
                TextColor3 = Theme.Accent,
                AutoButtonColor = false,
            }, { corner(6) })

            local obj = { Value = c.Default or Enum.KeyCode.Unknown }
            local listening = false
            local function render()
                btn.Text = listening and "..." or obj.Value.Name
            end
            function obj:Set(k)
                obj.Value = k
                render()
            end
            btn.MouseButton1Click:Connect(function()
                listening = true
                render()
            end)
            track(UserInputService.InputBegan:Connect(function(input, gp)
                if listening then
                    if input.UserInputType == Enum.UserInputType.Keyboard then
                        listening = false
                        if input.KeyCode ~= Enum.KeyCode.Escape then
                            obj.Value = input.KeyCode
                            if c.Changed then task.spawn(pcall, c.Changed, obj.Value) end
                        end
                        render()
                    end
                    return
                end
                if not gp and obj.Value ~= Enum.KeyCode.Unknown
                    and input.KeyCode == obj.Value and c.Callback then
                    task.spawn(pcall, c.Callback)
                end
            end))
            render()
            return obj
        end

        return Tab
    end

    if key == nil then
        openFirst()
    end

    return Window, backgroundImage
end

