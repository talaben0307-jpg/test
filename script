-- Tải ảnh nền ở nền (không chặn menu), xong thì cập nhật hình
task.spawn(function()
    if not fsOk then return end
    for _, p in ipairs(BG_PRESETS) do
        pcall(function()
            if not isfile(presetPath(p)) then
                local data = game:HttpGet(p.Url)
                if data and #data > 0 then
                    writefile(presetPath(p), data)
                end
            end
        end)
    end
    refreshFurinaIcon()
    applyPreset(initialPreset(), true)
end)
-- Nếu ảnh đã có sẵn từ lần chạy trước thì hiện ngay
