local function charAlive(char)
    if not (char and char.Parent) then return false end
    local hum = char:FindFirstChildOfClass("Humanoid")
    return hum ~= nil and hum.Health > 0 and char:FindFirstChild("HumanoidRootPart") ~= nil
end

local function clearCamHighlight()
    if camHighlight then
        camHighlight:Destroy()
        camHighlight = nil
    end
end

local function updateCamHighlight()
    local char = camlock.Enabled and camlock.Highlight and camlock.Target
    if not char then
        clearCamHighlight()
        return
    end
    if not camHighlight or camHighlight.Parent ~= char then
        clearCamHighlight()
        camHighlight = Instance.new("Highlight")
        camHighlight.Name = "RainbowHighlight"
        camHighlight.Adornee = char
        camHighlight.FillTransparency = 0.5
        camHighlight.OutlineTransparency = 0
        camHighlight.Parent = char
    end
